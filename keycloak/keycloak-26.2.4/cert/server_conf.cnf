[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = req_distinguished_name
req_extensions     = req_ext

[ req_distinguished_name ]
C  = DE
ST = BW
L  = Freiburg
O  = MZ Automation GmbH
OU = R&D
CN = websocketClient

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = websocketClient
DNS.2 = localhost
IP.1 = 127.0.0.1