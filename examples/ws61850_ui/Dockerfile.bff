#
# Build context: repo root  (docker compose sets this via `context: ../..`)
# Usage:  docker compose build bff

FROM python:3.12-slim AS deps
WORKDIR /build

# Install Python dependencies (pinned from pyproject.toml + waitress for production WSGI)
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir \
        asn1tools==0.167.0 \
        websockets==16.0 \
        bitstruct==8.21.0 \
        certifi==2026.1.4 \
        cryptography==46.0.5 \
        pyjwt==2.10.1 \
        requests==2.32.5 \
        aiohttp==3.13.3 \
        "flask>=3.1.3" \
        waitress

# Install the ws61850 library from source
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir -e .


FROM deps AS runtime
WORKDIR /app

# Copy the BFF application
COPY examples/ws61850_ui/app.py ./
COPY examples/ws61850_ui/bff/ ./bff/

# In production these are served by Nginx; the BFF only needs them for
# standalone (no-Nginx) mode.  Create placeholder dirs so Flask doesn't warn.
RUN mkdir -p templates static

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    WS61850_GUI_LOG_LEVEL=INFO

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/status')" || exit 1

CMD ["python", "-m", "waitress", "--host=0.0.0.0", "--port=8000", "app:app"]
