#
# RTI-FSP: Headless ws_client + iec_server — dials out to an RTI-SO endpoint.
# Build context: repo root  (docker compose sets this via `context: ../..`)

FROM python:3.12-slim AS deps
WORKDIR /build

RUN pip install --no-cache-dir \
        asn1tools==0.167.0 \
        websockets==16.0 \
        bitstruct==8.21.0 \
        certifi==2026.1.4 \
        cryptography==46.0.5 \
        pyjwt==2.10.1 \
        requests==2.32.5 \
        aiohttp==3.13.3

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir -e .


FROM deps AS runtime
WORKDIR /app

COPY examples/ws61850_ui/simulator/rti_fsp.py ./

ENV PYTHONUNBUFFERED=1 \
    FSP_TARGET_HOST=rti-so \
    FSP_TARGET_PORT=9100 \
    FSP_CP=cp1 \
    FSP_MODEL=1 \
    FSP_UPDATE_INTERVAL=15 \
    LOG_LEVEL=INFO

CMD ["python", "rti_fsp.py"]
