# ─────────────────────────────────────────────────────────────────────────────
# RTI Demo UI — environment variables
# Copy to .env and adjust values for your deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── RTI-BFF ───────────────────────────────────────────────────────────────────

# Python log level for the BFF (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# ── Frontend (React / Vite) ───────────────────────────────────────────────────
# These are baked into the JS bundle at build time (VITE_ prefix required).

# Browser tab / app title.
VITE_APP_TITLE=RTI Demo UI

# Size of the in-memory ring buffer for report-update events.
VITE_EVENT_BUFFER_SIZE=5000

# ── Docker port mappings (host side) ─────────────────────────────────────────

# Port on the host where the Nginx UI container is reachable.
UI_PORT=8185

# Port on the host where the BFF REST API is directly reachable.
BFF_PORT=8100

# IEC WebSocket port for the BFF's rti-so target (ws_server + iec_client).
# RTI-FSP (or any ws_client + iec_server) connects here after:
#   POST /api/connect {"target":"rti-so","port":9000,"cp":"cp1","is_server":true}
BFF_SO_PORT=9000

# ── RTI-SO (ws_server + iec_client) ──────────────────────────────────────────

# Host port the RTI-SO WebSocket server is reachable on.
RTI_SO_PORT=9100

# Comma-separated connection points the RTI-SO registers IEC clients for.
RTI_SO_CP=cp1,cp2

# Seconds between server-directory polls on a connected IED (0 = disabled).
RTI_SO_POLL_INTERVAL=30

# ── RTI-FSP (ws_client + iec_server) ─────────────────────────────────────────

# Which RTI-SO host RTI-FSP dials into.
# Use "bff" and port BFF_SO_PORT to route through the BFF instead.
FSP_TARGET_HOST=rti-so
FSP_TARGET_PORT=9100

# Connection point and IED model variant (1 or 2).
FSP_CP=cp1
FSP_MODEL=1

# Seconds between simulated value updates (0 = disabled).
FSP_UPDATE_INTERVAL=15
