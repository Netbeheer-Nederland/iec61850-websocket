#
# Build context: repo root  (docker compose sets this via `context: ../..`)
# Usage:  docker compose build ui

FROM node:22-alpine AS builder
WORKDIR /app

# Install dependencies (cache layer)
COPY examples/ws61850_ui/ui/package*.json ./
RUN npm ci

# Copy source and build
COPY examples/ws61850_ui/ui/ ./

# Bake environment into the bundle at build time.
# Override these build args for custom deployments.
ARG VITE_APP_TITLE=RTI\ Demo\ UI
ARG VITE_EVENT_BUFFER_SIZE=5000

RUN npm run build


FROM nginx:1.27-alpine AS runtime

# Remove default Nginx config
RUN rm /etc/nginx/conf.d/default.conf

COPY examples/ws61850_ui/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1
