# RTI Demo IEC 61850 Server Docker Image
# Build context: iec61850-websocket/ (repo root)

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=5001

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Copy ws61850 to app directory
COPY src/ws61850 /app/ws61850
ENV PYTHONPATH="/app:${PYTHONPATH}"

# Copy BFF uv project files FIRST
COPY examples/rti-demo/pyproject.toml examples/rti-demo/uv.lock /app/

# Copy FSP modules
COPY examples/rti-demo/fsp/ /app/fsp/
# Copy demo_IO modules (needed for IO client sync)
COPY examples/rti-demo/demo_IO/ /app/demo_IO/

# Install dependencies from uv.lock (ONLY once, AFTER pyproject.toml is copied)
RUN uv sync --frozen --no-dev

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:5001/api/status || exit 1

CMD ["./.venv/bin/python", "-u", "fsp/bff_endpoint.py"]