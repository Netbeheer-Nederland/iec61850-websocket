# RTI Demo SO (Acsi-Client) Docker Image - Multi-stage
# Build context: repo root (see docker-compose.yml: context ../.., dockerfile examples/rti-demo/Dockerfile.rti-so)

# ============================================================
# Stage 1: Builder
# ============================================================
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system

WORKDIR /app

# Copy pyproject.toml and uv.lock FIRST
COPY examples/rti-demo/pyproject.toml /app/pyproject.toml
COPY examples/rti-demo/uv.lock /app/uv.lock

# Then copy source code
COPY src/ws61850 /app/ws61850
COPY examples/rti-demo/so/ /app/so/

ENV PYTHONPATH="/app:${PYTHONPATH}"

# Now uv sync can find the files
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev


# ============================================================
# Stage 2: Runtime
# ============================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=5001 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app:${PYTHONPATH}"

# curl is required for the health check
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /usr/sbin/nologin app

# Copy application and virtual environment
COPY --from=builder --chown=app:app /app /app

USER app

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:5001/api/status || exit 1

CMD ["python", "-u", "so/bff_endpoint.py"]
