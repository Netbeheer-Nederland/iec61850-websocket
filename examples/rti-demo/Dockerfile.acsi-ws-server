# RTI Demo IEC 61850 Server Docker Image - Multi-stage
# Build context: repo root (see docker-compose.yml: context ../.., dockerfile examples/rti-demo/Dockerfile.acsi-ws-server)

# ============================================================
# Stage 1: Builder
# ============================================================
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system

WORKDIR /app

# Copy ws61850 as local module (must be before dependency install)
COPY src/ws61850 /app/ws61850

# Copy project files for dependency management
COPY examples/rti-demo/pyproject.toml examples/rti-demo/uv.lock /app/

# Make ws61850 importable
ENV PYTHONPATH="/app:${PYTHONPATH}"

# Install dependencies from lockfile
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Copy application code
COPY examples/rti-demo/acsi_ws_server/ /app/acsi_ws_server/


# ============================================================
# Stage 2: Runtime
# ============================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=5001 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app:${PYTHONPATH}"

# curl is required for the health check
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /usr/sbin/nologin app

# Copy application and virtual environment
COPY --from=builder --chown=app:app /app /app

USER app

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:5004/api/status || exit 1

CMD ["python", "-u", "acsi_ws_server/bff_endpoint.py"]
