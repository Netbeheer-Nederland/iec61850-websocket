# RTI Demo IEC 61850 Server Docker Image
# Build context: iec61850-websocket/ (repo root)

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=5001

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy ws61850 as local module (must be before dependency install)
COPY src/ws61850 /app/ws61850

# Copy project files for dependency management
COPY examples/rti-demo/pyproject.toml examples/rti-demo/uv.lock /app/

# Make ws61850 importable
ENV PYTHONPATH="/app:${PYTHONPATH}"

# Install dependencies from lockfile
RUN uv sync --frozen --no-dev

# Copy application code
COPY examples/rti-demo/acsi_ws_server/ /app/acsi_ws_server/

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:5004/api/status || exit 1

CMD ["./.venv/bin/python", "-u", "acsi_ws_server/bff_endpoint.py"]