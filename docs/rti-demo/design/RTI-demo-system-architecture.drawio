        <mxCell id="n17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4c5f7;strokeColor=#8b3cb8;fontColor=#303238;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=6;opacity=100;dashed=1;" value="&lt;b&gt;dr-panel&lt;/b&gt; (opt-in)&lt;br&gt;IO server + plugin &lt;i&gt;dr_panel&lt;/i&gt;&lt;br&gt;:9000/plugin · routes /api/io&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;docker-compose.io.yaml: one for the FSPs and SO, instead of dr_leds&lt;/font&gt;" vertex="1">
