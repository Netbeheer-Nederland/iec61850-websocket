        <mxCell id="n21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4c5f7;strokeColor=none;fontColor=#303238;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=6;opacity=100;" value="&lt;b&gt;dr-leds-fsp01&lt;/b&gt;&lt;br&gt;plugin &lt;i&gt;dr_leds&lt;/i&gt;&lt;br&gt;:8099/plugin" vertex="1">
          <mxGeometry height="90" width="220" x="1110" y="690" as="geometry" />
